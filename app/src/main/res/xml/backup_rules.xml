<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: back up nothing. Aira keeps all its data on the phone. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
