# Copy this file to "keystore.properties" (same folder) and fill in your own values.
# keystore.properties is ignored by git: never commit it, and never commit the .jks file.
#
# storeFile is relative to the project folder. Keep the keystore file OUTSIDE the project if you can,
# for example: ../aira-keystore/aira-release.jks
storeFile=../aira-keystore/aira-release.jks
storePassword=your-store-password
keyAlias=aira
keyPassword=your-key-password
